#!/usr/bin/env bash
# news — one entry point for newsline
#
#   news                    open the Mac reader (default)
#   news run [--hours N]    fetch + score + match + rewrite once
#   news stories            list active storylines
#   news story <id-prefix>  show one storyline's timeline
#   news chat <id> "..."    ask a question grounded in a story
#   news signals [--days N] inspect feedback signals
#   news digest [--days N]  markdown digest of recent storylines
#   news kick               trigger the daily LaunchAgent right now
#   news log                tail the daemon log
#   news doctor             validate config, API key, LLM round-trip, DB
#   news where              print the data dir
#   news build              build a Newsline.app bundle (no Xcode)
#   news install            symlink the .app into ~/Applications

set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"

APP_BUNDLE="$PROJECT_DIR/apps/macos/build/Newsline.app"
APP_LINK="$HOME/Applications/Newsline.app"

cmd="${1:-app}"
case "$cmd" in
    app|open|"")
        # First-run: build the .app and symlink it into ~/Applications.
        if [[ ! -d "$APP_BUNDLE" ]]; then
            echo "→ First run: building Newsline.app…"
            "$PROJECT_DIR/scripts/build-app.sh"
        fi
        if [[ ! -L "$APP_LINK" && ! -d "$APP_LINK" ]]; then
            "$PROJECT_DIR/scripts/install-app.sh"
        fi
        exec open -a Newsline
        ;;
    kick)
        exec launchctl kickstart -k "gui/$(id -u)/com.newsline.daily"
        ;;
    log)
        exec tail -f "$HOME/Library/Logs/newsline.log"
        ;;
    build)
        exec "$PROJECT_DIR/scripts/build-app.sh"
        ;;
    install)
        exec "$PROJECT_DIR/scripts/install-app.sh"
        ;;
    -h|--help|help)
        sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        ;;
    *)
        cd "$PROJECT_DIR"
        exec uv run --quiet newsline "$@"
        ;;
esac
